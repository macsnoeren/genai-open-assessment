# config.py

# API-sleutel voor de webapplicatie
API_KEY = "<HERE_COMES_YOUR_API_KEY>"

# URL van de webapplicatie API. Buiten localhost is https:// verplicht
# (de API-key gaat als Bearer-token in de Authorization-header mee).
BASE_URL = "https://test.jmnl.nl/api/index.php"

# Alleen voor lokale tests zonder TLS: sta een http:// BASE_URL toe.
# ALLOW_INSECURE_BASE_URL = True

# Tijdelijke brug als de server nog de OUDE code draait (key alleen via
# ?api_key=). Zet op True tot de nieuwe versie is uitgerold, daarna weer op
# False: met deze vlag aan belandt de key in de access log van de server.
# Zie docs/rollout-new-version.md.
LEGACY_API_KEY_IN_QUERY = False

# URL van de Ollama API. Het script gebruikt /api/chat; een URL die op
# /api/generate eindigt wordt automatisch omgezet.
OLLAMA_URL = "http://localhost:11434/api/chat"

# Lijst met LLM-modellen die gebruikt worden voor de beoordeling.
# Cloud-modellen (Ollama Cloud, "-cloud" suffix) draaien op ollama.com i.p.v.
# lokaal, dus is geen GPU nodig. Vereist een 'ollama signin' op deze machine.
# gpt-oss:20b-cloud en gpt-oss:120b-cloud vallen onder de gratis laag.
LLM_MODELS = [
    "gpt-oss:20b-cloud",
    "gpt-oss:120b-cloud",
]

# Interval in seconden voor het ophalen van nieuwe antwoorden
POLL_INTERVAL = 30
# Model dat elk studentantwoord vooraf controleert op prompt injection.
# Zet op None om deze controle uit te schakelen.
INJECTION_CHECK_MODEL = "gpt-oss:20b-cloud"

# "think"-instelling per modelfamilie (prefix-match). gpt-oss negeert False
# en redeneert dan op "medium"; "low" verbruikt ~4x minder. qwen3 kent alleen
# aan/uit en staat AAN: zonder denken volgt het instructies slecht en ratelt
# het door in het feedback-veld. Redeneertokens tellen mee voor num_predict.
THINK_LEVELS = {"gpt-oss": "low", "qwen3": True}

# Tokenbudget (num_predict) per aanroep. Redeneertokens tellen hierin mee,
# dus met denken aan moet dit ruim zijn. Als het budget opgaat aan denken,
# wordt het voor een volgende poging verdubbeld tot NUM_PREDICT_MAX.
NUM_PREDICT_FEEDBACK = 5000
NUM_PREDICT_INJECTION = 2000
NUM_PREDICT_MAX = 7000

# Harde bovengrens (tekens) per tekstveld in het JSON-schema; de grammar
# dwingt dan het einde van de string af. De zichtbare output blijft zo klein,
# ook al krijgt het model een ruim tokenbudget om te denken.
MAX_OUTPUT_FIELD_CHARS = 600

# Sampling-opties tegen herhalingslussen (advies van Qwen voor denkmodus;
# greedy/lage temperatuur leidt daar juist tot eindeloze herhaling).
# SAMPLING_OPTIONS = {"temperature": 0.6, "top_p": 0.95, "top_k": 20,
#                     "repeat_penalty": 1.1, "presence_penalty": 1.0}

# Maximale lengte (tekens) van de feedback- en uitlegtekst die wordt opgeslagen.
# Langere tekst wordt op een woordgrens afgekapt met een [...]-markering.
MAX_FEEDBACK_CHARS = 1500

# Maximaal aantal zinnen per tekstveld (feedback, uitleg). Wordt aan het model
# gevraagd én hard afgedwongen in de code. 0 = geen limiet.
MAX_FEEDBACK_SENTENCES = 4

# Zet de AI-score op 0 als de voorcontrole prompt injection vermoedt.
# De oorspronkelijke score blijft zichtbaar in de feedbacktekst voor de docent.
INJECTION_ZERO_SCORE = True

# Aantal pogingen voordat een antwoord als "niet beoordeelbaar" wordt gemarkeerd
MAX_ATTEMPTS = 3

# Contextvenster (tokens) dat aan Ollama wordt doorgegeven
NUM_CTX = 8192

# Maximale lengte (tekens) van het studentantwoord dat naar het model gaat
MAX_ANSWER_CHARS = 4000
